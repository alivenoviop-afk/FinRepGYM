# Официальная проверка проходит БЕЗ СЕТИ: внутри образа только Python и наш код.
# Внешних зависимостей нет вообще (стандартная библиотека), pip install не выполняется.
#
# Сборка требует сети ОДИН раз (скачивание базового образа python:3.11-slim);
# сам запуск и все проверки работают полностью офлайн.
FROM python:3.11-slim

WORKDIR /app

# Всё содержимое репозитория (история git и мусор исключены в .dockerignore)
COPY . .

# Единая команда проверки = та же, что и локально:
#   юнит-тесты (206) + все регламентные проверки (34/34)
# Эквивалент: python -m unittest discover -s tests && python scripts/check.py
CMD ["python", "scripts/check.py"]
